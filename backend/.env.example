# Copy this file to .env and fill in real values. Never commit the real .env.

# Google Gemini API key used by the AI tutor / question generator / marking / notes features.
GOOGLE_API_KEY=

# Secret used to sign JWT session tokens. Generate a real random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The server refuses to start without this set.
JWT_SECRET_KEY=

# Comma-separated list of frontend origins allowed to call this API in
# production (Render). Localhost is always allowed automatically for local
# dev, so you don't need to list it here.
#   ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-git-main-you.vercel.app
ALLOWED_ORIGINS=
