# Copy this file to .env.local (for local dev) and fill in real values.
# Vite only reads files named .env, .env.local, .env.[mode], etc. from this
# (the frontend project root) — NOT from backend/.env.

# URL of the FastAPI backend. Defaults to http://localhost:8000 if unset,
# which is fine for local dev. In production (Vercel), set this to your
# deployed Render backend URL, e.g. https://your-app.onrender.com
VITE_API_URL=http://localhost:8000
